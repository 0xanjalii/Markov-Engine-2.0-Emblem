# ==============================================================================
# Walrus Memory (MemWal) Environment Configuration - Markov Engine 2.0
# ==============================================================================

# Your Walrus Memory API Key (from https://memory.walrus.xyz)
MEMWAL_API_KEY=your_memwal_api_key_here

# MemWal Service Relayer Endpoint (default: https://relayer.memory.walrus.xyz)
MEMWAL_ENDPOINT=https://relayer.memory.walrus.xyz

# Target Sui Network (mainnet / testnet)
SUI_NETWORK=mainnet

# Your Walrus Memory Account Object ID (from https://memory.walrus.xyz)
# MEMWAL_ACCOUNT_ID=0x...
